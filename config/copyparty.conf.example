# not actually YAML but lets pretend:
# -*- mode: yaml -*-
# vim: ft=yaml:


[global]
  e2dsa  # enable file indexing and filesystem scanning
  e2ts   # enable multimedia indexing
  ansi   # enable colors in log messages (both in logfiles and stdout)

  # q, lo: /cfg/log/%Y-%m%d.log   # log to file instead of docker

  p: 3923            # listen on another port
  # ipa: 10.89.      # only allow connections from 10.89.*
  df: 16             # stop accepting uploads if less than 16 GB free disk space
  ver                # show copyparty version in the controlpanel
  # grid             # show thumbnails/grid-view by default
  # theme: 2         # monokai
  name: server       # change the server-name that's displayed in the browser
  # stats, nos-dup   # enable the prometheus endpoint, but disable the dupes counter (too slow)
  # no-robots, force-js  # make it harder for search engines to read your server

  # Proxy settings
  xff-hdr: x-forwarded-for
  xff-src: lan
  rproxy: 1
  xf-proto: x-forwarded-proto
  xf-host: x-forwarded-host

[accounts]
  # CHANGE THIS before deploying! This is a placeholder account with a
  # weak, publicly-known password. Pick a real username and a long,
  # unique password (or use `--ah-alg argon2` / hashed passwords, see
  # https://github.com/9001/copyparty#account-passwords).
  admin: CHANGE_ME_TO_A_STRONG_PASSWORD  # username: password


[/]              # create a volume at "/" (the webroot), which will
  /w             # share /w (the docker data volume)
  accs:
    # No "*" entry, so nothing is accessible without logging in. Adding
    # one (e.g. "r: *") opens the volume to anonymous visitors.
    rw: @acct     # every logged-in account gets read-write access, and
    rwmda: admin  # the user "admin" gets read-write-move-delete-admin


# To limit an account to a single folder, add it under [accounts] and give
# the folder its own volume, like the commented-out example below ("guest"
# may only use /w/guest, which it sees as /guest). Access is per volume and
# not inherited, so:
#  * an account that is not listed in a volume's accs cannot open it, and
#  * "@acct" matches every account -- replace "rw: @acct" above with the
#    accounts that may see everything (e.g. "rw: alice, bob"), otherwise
#    the restricted account gets the whole webroot as well.
#
# [/guest]          # the URL of the folder, and
#   /w/guest        # its location on the docker data volume
#   accs:
#     rw: guest     # "guest" gets read-write access to this folder only
#     rwmda: admin  # access is not inherited, so list "admin" again
